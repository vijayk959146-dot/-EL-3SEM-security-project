# Copy this file to .env and fill in values. Never commit .env.

# ---------------------------------------------------------------------------
# AWS Configuration
# ---------------------------------------------------------------------------
# Leave empty on EC2 to automatically use IAM Instance Profile (Recommended)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Amazon Bedrock Foundation Model ID (Converse API)
# Recommended: amazon.nova-micro-v1:0 (fast, cheap) or us.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# ---------------------------------------------------------------------------
# Strands Decider 2B Configuration
# ---------------------------------------------------------------------------
# Docker Compose internal URL: http://decider:8099
# Local standalone development URL: http://127.0.0.1:8099
DECIDER_URL=http://decider:8099
DECIDER_THRESHOLD=0.7

# ---------------------------------------------------------------------------
# Dashboard Authentication & Access Control (Required for Public Deployment)
# ---------------------------------------------------------------------------
DASHBOARD_PASSWORD=replace_with_a_long_random_password
ALLOW_ANONYMOUS_DASHBOARD=false

# ---------------------------------------------------------------------------
# Optional Reverse Proxy Domain (for Caddy automatic Let's Encrypt SSL)
# ---------------------------------------------------------------------------
# Example: attack-surface.yourdomain.com (Leave blank or :80 for direct IP access)
DOMAIN_NAME=

# ---------------------------------------------------------------------------
# Target & Correlation Configuration
# ---------------------------------------------------------------------------
# Optional NVD API key to raise public rate limits: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Default target for quick scans — must also appear in targets.allowlist or be verified
DEFAULT_TARGET=localhost
DEFAULT_PORTS=80,443,3000,8000,8080
