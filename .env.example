# Copy this file to .env and fill in values. Never commit .env.

# AWS region where Bedrock is enabled (must match aws configure).
AWS_REGION=us-east-1

# Model ID from the Bedrock console (Model access). Example Claude 3.5 Sonnet:
# anthropic.claude-3-5-sonnet-20241022-v2:0
# Some accounts require an inference profile ID instead (starts with us. or eu.).
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Optional. Raises NVD rate limits. Get one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Default scan target — must also appear in targets.allowlist
DEFAULT_TARGET=localhost
DEFAULT_PORTS=80,443,3000,8000,8080
