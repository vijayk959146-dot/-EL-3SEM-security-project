# Copy this file to .env and fill in values. Never commit .env.

# AWS credentials (optional if using EC2 IAM Role or local AWS SSO/CLI profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Model ID from Bedrock. Works with Amazon Nova, Anthropic Claude, Meta Llama, etc.
# Default: amazon.nova-micro-v1:0 (fast, cost-effective, model-agnostic Converse API)
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# Optional NVD API key to raise public rate limits: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Password protection for Streamlit dashboard. Required for deployed access.
DASHBOARD_PASSWORD=replace_with_a_long_random_password
ALLOW_ANONYMOUS_DASHBOARD=false

# Target configuration — must also appear in targets.allowlist
DEFAULT_TARGET=localhost
DEFAULT_PORTS=80,443,3000,8000,8080
